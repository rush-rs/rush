let ITERATIONS = 10000;

fn main() {
    let mut k = 3f;
    let mut s = 1f;

    for i = 0; i < ITERATIONS; i+= 1 {
        s = s-((1f / k) * ((-1) ** i) as float);
        k += 2f;
    }

    let result = ((4f * s) * 1000f) as int;

    if result == 3141 {
        // success, the computation was successful
        exit(0);
    } else {
        // failure
        exit(1);
    }
}
