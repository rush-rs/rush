let ITERATIONS = 10000;
let ACCEPTABLE_ROUNDING_ERROR = 9;
let EXPECTED = 3141;

fn abs(n: int) -> int {
    if n < 0 {
        -n
    } else {
        n
    }
}

fn main() {
    let mut k = 3f;
    let mut s = 1f;

    for i = 0; i < ITERATIONS; i+= 1 {
        s = s-((1f / k) * ((-1) ** i) as float);
        k += 2f;
    }

    let result = ((4f * s) * 1000f) as int;

    if result == EXPECTED {
        // success, the computation was successful
        exit(0);
    } else if abs(result - EXPECTED) <= ACCEPTABLE_ROUNDING_ERROR {
        // success, the computation was successful
        exit(0);
    } else {
        // failure
        exit(result / 100);
    }
}
