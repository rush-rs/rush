let APERY = 1.2020569;
let ACCEPTABLE_ROUNDING_ERROR=897;

fn abs(v: int) -> int {
    if v < 0 {
        -v
    } else {
        v
    }
}

fn main() {
    let mut res = 1f;

    for i = 2; i < 30000; i += 1 {
        res += (1f / (i ** 3) as float);
    }

    let FAC = 10000000f;
    let res = (res * FAC) as int;
    let expected = (APERY * FAC) as int;
    if abs(expected - res) <= ACCEPTABLE_ROUNDING_ERROR {
        // success
        exit(0);
    } else {
        // failure
        exit(1);
    }
}
